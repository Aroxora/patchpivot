{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchpivot.local/schemas/artifact-manifest.schema.json",
  "title": "PatchPivot Artifact Manifest",
  "type": "object",
  "required": ["generatedAt", "root", "type", "files", "manifestSha256"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["file", "directory"]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "outputFile": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
